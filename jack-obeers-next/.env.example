# Names only. Never commit real values. Set them in Vercel, not in a file or a message.
# Not used yet: the site runs on sample data until the Shopify store is approved and connected.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
CHECKOUT_ENABLED=false

# Owners and members (server only). Never commit real values.
# At least 32 random characters. Signs the sign-in cookies.
SESSION_SECRET=
# name:salt:hash, separated by ;  Make each with: node scripts/hash-password.mjs michael
OWNER_USERS=
# Preview only. Lets you try the owners page as demo / demo-preview, and the members page as a Regular or a Legend. NEVER set these on the live site.
OWNER_DEMO=false
MEMBERS_DEMO=false
# mock keeps events in memory. shopify creates them as Shopify products (needs the three values below).
EVENTS_BACKEND=mock
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_PUBLICATION_ID=
