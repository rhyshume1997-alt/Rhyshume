{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/w-82503121e7fdf54e(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/c-09b37e50c043baaa(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/c-3e9a41b7d20f58c6(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/preview/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/upgrade",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/build-concepts",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/website-concepts/(olive-ivory|bright-circuit|salt-ember|sunny-hours|clear-ground|little-kettle|corner-shelf|oak-razor)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/business-review/report",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/upgrade-live.js": {
      "maxDuration": 120,
      "includeFiles": "{styles.css,preview/preview.css}"
    },
    "api/owner-build.js": {
      "maxDuration": 120,
      "includeFiles": "{styles.css,preview/preview.css}"
    },
    "api/business-review.js": {
      "maxDuration": 60
    },
    "api/business-review-admin.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/business-review-admin?route=sweep",
      "schedule": "17 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/business-review/admin/:path*",
      "destination": "/api/business-review-admin?route=:path*"
    },
    {
      "source": "/api/business-review/:path*",
      "destination": "/api/business-review?route=:path*"
    },
    {
      "source": "/c/:id",
      "destination": "/api/c?id=:id"
    }
  ]
}
