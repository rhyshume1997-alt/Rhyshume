# Names only. Set the real values in the host's environment settings. Never commit values.

# Required. Resend API key used to send the enquiry email.
MARPET_RESEND_API_KEY=
# Required. Where enquiries are delivered (comma separate for more than one address).
MARPET_ENQUIRY_TO=
# Required. Sender, on a domain verified in Resend, e.g. Name <address@verified-domain>.
MARPET_ENQUIRY_FROM=
# Required. Cloudflare Turnstile secret key (server side). Without it the form refuses every send.
MARPET_TURNSTILE_SECRET_KEY=
# Optional. Comma separated hostnames a Turnstile token must come from (the live site's hostnames).
MARPET_TURNSTILE_HOSTNAMES=
